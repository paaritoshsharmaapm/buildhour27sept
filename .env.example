# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# Where the key comes from: https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_OWN_KEY

# Model ID must exist on your account. Check https://console.groq.com/docs/models
# Default in src/config.py is qwen/qwen3.8-27b.
GROQ_MODEL=qwen/qwen3.8-27b

# Retrieval tuning. See implementation.md §18c for how GROUNDING_THRESHOLD was
# calibrated and why it was left at 0.35.
# GROUNDING_THRESHOLD=0.35
# CONTEXT_TOP_K=3
# TOP_K=5
# MMR_LAMBDA=0.7
